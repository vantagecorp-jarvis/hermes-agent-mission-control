# Local development template; never commit a populated environment file.
# Docker uses .env.production.example + .env.db.example instead (see DEPLOY.md).
DATABASE_URL="postgresql://mission_control:REPLACE_WITH_DB_PASSWORD@localhost:5432/mission_control"
POSTGRES_URL="postgresql://mission_control:REPLACE_WITH_DB_PASSWORD@localhost:5432/mission_control"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_32_BYTE_OR_LONGER_SECRET"
# Exact format: scrypt$<32 lowercase hex salt>$<128 lowercase hex derived key>
# Generate using the hidden-input procedure in DEPLOY.md. No plaintext password.
OWNER_PASSWORD_HASH='REPLACE_WITH_SCRYPT_HASH_FROM_AUTH_HASH_SCRIPT'
NEXT_PUBLIC_OWNER_NAME="Owner"
# Optional feature integrations (not required for login/dashboard):
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# BRAVE_API_KEY=
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_ID=
# TWITTER_BEARER_TOKEN=
# NOTION_API_KEY=
# HL_WALLET=
# Bridge intentionally disabled; do not add host mounts or start it.
